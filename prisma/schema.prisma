generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { ADMIN TEACHER STUDENT }
enum StudentStatus { ACTIVE INACTIVE GRADUATED }
enum AttendanceStatus { PRESENT LATE PERMISSION SICK ABSENT }
enum SessionType { CHECK_IN CHECK_OUT }

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  active       Boolean  @default(true)
  teacher      Teacher?
  student      Student?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ClassRoom {
  id          String    @id @default(cuid())
  name        String
  major       String?
  grade       String?
  students    Student[]
  homeroomId  String?
  homeroom    Teacher?  @relation(fields: [homeroomId], references: [id])
  createdAt   DateTime  @default(now())
  @@unique([name, major])
}

model Teacher {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNo String?  @unique
  classes   ClassRoom[]
}

model Student {
  id          String        @id @default(cuid())
  userId      String?       @unique
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  nis         String        @unique
  nisn        String?       @unique
  name        String
  gender      String?
  phone       String?
  address     String?
  photoUrl    String?
  qrValue     String        @unique
  status      StudentStatus @default(ACTIVE)
  classId     String
  classroom   ClassRoom     @relation(fields: [classId], references: [id])
  attendances Attendance[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([classId, status])
  @@index([name])
}

model AttendanceSession {
  id          String       @id @default(cuid())
  name        String
  type        SessionType  @default(CHECK_IN)
  startsAt    DateTime
  endsAt      DateTime
  lateAfter   DateTime
  active      Boolean      @default(true)
  attendances Attendance[]
  createdAt   DateTime     @default(now())
}

model Attendance {
  id          String           @id @default(cuid())
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id])
  sessionId   String
  session     AttendanceSession @relation(fields: [sessionId], references: [id])
  date        DateTime         @db.Date
  status      AttendanceStatus
  scannedAt   DateTime         @default(now())
  method      String           @default("QR")
  recordedBy  String?
  note        String?
  logs        AttendanceLog[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@unique([studentId, sessionId, date])
  @@index([date, status])
  @@index([sessionId, date])
}

model AttendanceLog {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  actorId      String?
  action       String
  before       Json?
  after        Json?
  createdAt    DateTime   @default(now())
}

model SchoolSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
